# Load credentials from your secret mechanism before running scripts/monitoring.py prepare.
# No cloud resources are created by prepare; these containers must already exist and be private.
MONITORING_LOGS_CONNECTION_STRING=
MONITORING_METRICS_CONNECTION_STRING=
MONITORING_LOGS_CONTAINER=vstore-obs-logs
MONITORING_METRICS_CONTAINER=vstore-obs-metrics
MONITORING_GRAFANA_PASSWORD=
METRICS_TOKEN=
# Runtime overrides (append to the generated private compose.env):
VSTORE_COMPOSE_PROJECT=vstore
MONITORING_GRAFANA_PORT=3300

# Set to the existing Docker containerd socket on this Linux host. Missing socket fails closed.
MONITORING_CONTAINERD_SOCKET=/run/containerd/containerd.sock

# Host-network collector endpoints; all published endpoints remain loopback-only.
MONITORING_PROMETHEUS_PORT=19090
MONITORING_LOKI_PORT=13100
MONITORING_API_ADDRESS=127.0.0.1:8080
