{
  "id": null,
  "uid": "vstore-application",
  "title": "VStore application",
  "description": "Store API, application containers, logs and alerts.",
  "tags": [
    "vstore"
  ],
  "timezone": "utc",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API: traffic, errors, latency",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(vstore_http_requests_total{job=\"api\"}[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx share",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(vstore_http_requests_total{job=\"api\",status=~\"5..\"}[5m])) / sum(rate(vstore_http_requests_total{job=\"api\"}[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data (unknown)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert VStoreHighErrorRate fires above 5% for 10 minutes."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vstore_http_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data (unknown)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Alert VStoreSlowResponses fires above 1 s for 10 minutes."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "API health probe",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "probe_success{job=\"api-health\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILING",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "description": "1 = reachable, 0 = failing, no data = unknown (never healthy)."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(vstore_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(vstore_http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "5xx per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(vstore_http_requests_total{job=\"api\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vstore_http_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vstore_http_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vstore_http_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "Slowest routes (p95, last 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(vstore_http_request_duration_seconds_bucket{job=\"api\"}[1h]))))",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "Application containers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory working set by service",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"vstore\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU cores by service",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"vstore\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Log lines per service",
      "datasource": {
        "type": "loki",
        "uid": "vstore-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\".+\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "vstore-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Error-looking log lines per service",
      "datasource": {
        "type": "loki",
        "uid": "vstore-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\".+\"} |~ \"(?i)(error|exception|traceback| 5[0-9]{2} )\" [5m]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "vstore-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {},
      "description": "Lines matching error, exception, traceback or an HTTP 5xx status. Search a request ID in the panel below or in Explore."
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Recent error-looking lines (backend, worker, proxy)",
      "datasource": {
        "type": "loki",
        "uid": "vstore-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service=~\"backend|worker|proxy\"} |~ \"(?i)(error|exception|traceback)\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "vstore-logs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "table",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 59,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {},
      "description": "Empty means no alert is firing. Routing and silences are in the Alertmanager dashboard (Community folder).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "vstore"
      ],
      "asDropdown": true
    }
  ]
}
