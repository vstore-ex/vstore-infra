      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Rule evaluation failures",
      "datasource": {
        "type": "prometheus",
        "uid": "vstore-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(prometheus_rule_evaluation_failures_total[5m]))",
          "legendFormat": "failures/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "vstore-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data (unknown)"
        },
        "overrides": []
