# =============================================================================
# Production Environment Variables Template for VStore Infrastructure
# Copy this file to .env and adjust sensitive values:
#   cp .env.example .env
# =============================================================================

# PostgreSQL Credentials and Configuration
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToStrongPostgresPassword123!

# PostgreSQL connection string for backend service (within app_net Docker bridge)
DATABASE_URL=postgresql://postgres:ChangeThisToStrongPostgresPassword123!@postgres:5432/app

# Initial Administrator Credentials (used during database bootstrap/seed)
ADMIN_EMAIL=admin@vstore.local
ADMIN_PASSWORD=ChangeThisToStrongPassword123!

# JWT Secret Key for token signing and verification (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min

# Azure Blob Storage Connection String for game media and avatars (optional)
AZURE_STORAGE_CONNECTION_STRING=

# Celery & Redis Configuration (for background worker, cache, rate limits, token blacklist)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Google OAuth & Frontend URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins, including the production storefront/admin origins.
CORS_ALLOWED_ORIGINS=

# Resend transactional email
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM="VStore <no-reply@your-verified-domain.example>"

# Reverse Proxy & Edge Gateway Configuration
# Backend raw-header trust is disabled by Compose. Uvicorn trusts only these hops.
# Change all five together if this subnet overlaps an existing host/VPN network.
PROXY_NET_SUBNET=172.31.240.0/28
EDGE_PROXY_IP=172.31.240.2
FRONTEND_PROXY_IP=172.31.240.3
ADMIN_PROXY_IP=172.31.240.4
BACKEND_PROXY_IP=172.31.240.5
FRONTEND_DOMAIN=vstore.local
ADMIN_DOMAIN=admin.vstore.local
CERTBOT_EMAIL=admin@vstore.local
CERTBOT_STAGING=0
CERTBOT_FORCE_RENEWAL=0
# Set to 0 when admin uses a local hostname and a separate certificate.
CERTBOT_INCLUDE_ADMIN_DOMAIN=1
# Optional: certificate directory name for admin; defaults to FRONTEND_DOMAIN.
# ADMIN_CERT_NAME=vstore.local

# Container Images (GitHub Container Registry)
# Local-development defaults only. For a new production installation, replace
# all three with reviewed name@sha256:... references before the initial startup.
# After bootstrap, docker-compose.override.yml owns successful release images;
# its literal digests override these values. See docs/releases.md.
BACKEND_IMAGE=ghcr.io/vstore-ex/vstore:latest
FRONTEND_IMAGE=ghcr.io/vstore-ex/vstore-front:latest
ADMIN_IMAGE=ghcr.io/vstore-ex/vstore-admin:latest

# Initial edge install: use the digest published by the successful Infra CI gate.
# After first successful infra deploy, release state overrides this value too.
PROXY_IMAGE=ghcr.io/vstore-ex/vstore-infra-proxy:latest
