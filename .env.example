# =============================================================================
# Production Environment Variables Template for VStore Infrastructure
# Copy this file to .env and adjust sensitive values:
#   cp .env.example .env
# =============================================================================

# PostgreSQL Credentials and Configuration
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToStrongPostgresPassword123!

# PostgreSQL connection string for backend service (within app_net Docker bridge)
DATABASE_URL=postgresql://postgres:ChangeThisToStrongPostgresPassword123!@postgres:5432/app

# Initial Administrator Credentials (used during database bootstrap/seed)
ADMIN_EMAIL=admin@vstore.local
ADMIN_PASSWORD=ChangeThisToStrongPassword123!

# JWT Secret Key for token signing and verification (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars-min

# Azure Blob Storage Connection String for game media and avatars (optional)
AZURE_STORAGE_CONNECTION_STRING=

# Celery & Redis Configuration (for background worker, cache, rate limits, token blacklist)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Reverse Proxy & Edge Gateway Configuration
TRUST_PROXY_HEADERS=true
FRONTEND_DOMAIN=vstore.local
ADMIN_DOMAIN=admin.vstore.local
CERTBOT_EMAIL=admin@vstore.local
CERTBOT_STAGING=0
CERTBOT_FORCE_RENEWAL=0

# Container Images (GitHub Container Registry)
# Defaults for local use. CI deploys pin exact digests by exporting these
# variables (e.g. BACKEND_IMAGE=ghcr.io/vstore-ex/vstore@sha256:...) over .env.
BACKEND_IMAGE=ghcr.io/vstore-ex/vstore:latest
FRONTEND_IMAGE=ghcr.io/vstore-ex/vstore-front:latest
ADMIN_IMAGE=ghcr.io/vstore-ex/vstore-admin:latest

