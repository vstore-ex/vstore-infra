# =============================================================================
# VStore Edge Reverse Proxy Configuration Template
# Processed at container startup via envsubst with ${FRONTEND_DOMAIN} and ${ADMIN_DOMAIN}
# =============================================================================

# Disable server version tokens for security hardening
server_tokens off;

# Per-client flood limits; the app's Redis limiter still guards auth endpoints.
# Bursts cover a cold page load (HTML, JS, CSS, fonts, images, API calls).
limit_req_zone $binary_remote_addr zone=edge_req:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=edge_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# Map to determine connection upgrade header for WebSockets
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------------------------
# HTTP Server (Port 80): ACME Challenge & HTTP-to-HTTPS Redirection
# -----------------------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Liveness and readiness probe for container health checks
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # Let's Encrypt ACME HTTP-01 challenge verification
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Permanent 301 redirect for all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# -----------------------------------------------------------------------------
# HTTPS Server (Port 443): Customer Storefront
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${FRONTEND_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${FRONTEND_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FRONTEND_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # HTTP Strict Transport Security — instructs browsers to always use HTTPS
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # Storefront nginx caps bodies at 15M; nothing larger can succeed.
    client_max_body_size 15M;

    limit_req zone=edge_req burst=100 nodelay;
    limit_conn edge_conn 50;

    location / {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This is the first trusted hop: never retain client-supplied identity.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }
}

# -----------------------------------------------------------------------------
# HTTPS Server (Port 443): Admin Dashboard
# -----------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${ADMIN_DOMAIN};

    # Defaults to the storefront SAN certificate; may select a separate local certificate.
    ssl_certificate /etc/letsencrypt/live/${ADMIN_CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    # HTTP Strict Transport Security — instructs browsers to always use HTTPS
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # Admin video uploads need the larger limit.
    client_max_body_size 150M;

    limit_req zone=edge_req burst=100 nodelay;
    limit_conn edge_conn 50;

    location / {
        proxy_pass http://admin:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This is the first trusted hop: never retain client-supplied identity.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 60s;
    }
}
